%%{init: {"theme": "base", "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif", "themeCSS": ".nodeLabel, .edgeLabel, .cluster-label { font-family: Inter, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; }", "themeVariables": {"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif", "fontSize": "15px", "primaryColor": "#ffffff", "primaryBorderColor": "#335dff", "primaryTextColor": "#17224f", "lineColor": "#747b94", "clusterBkg": "#f9f9fb", "clusterBorder": "#c6ccdc", "titleColor": "#17224f", "edgeLabelBackground": "#f9f9fb"}, "flowchart": {"useMaxWidth": false, "subGraphTitleMargin": {"top": 6, "bottom": 10}, "curve": "basis", "nodeSpacing": 24, "rankSpacing": 34, "padding": 10, "wrappingWidth": 170}}}%%
flowchart TB
    Req(["<b>Request</b><br><i>Upgrade this project<br>from TinyMCE 6<br>to TinyMCE 8</i>"]):::ask
    subgraph before["<b>Before changing anything</b>"]
        direction LR
        S1["<b>1 · Record the baseline</b><br>version, every editor,<br>plugins, toolbar, content"]:::step
        S2["<b>2 · Confirm</b><br>target version and<br>license decision"]:::decide
        S1 --> S2
    end
    subgraph plan["<b>Plan the upgrade</b>"]
        direction LR
        S3["<b>3 · Worklist</b><br>checker in upgrade mode<br>lists every change"]:::check
        S4[("<b>4 · Read</b><br>migration guide<br>and release notes")]:::docs
        S5["<b>5 · Checklist</b><br>each change, with<br>its file and line"]:::step
        S3 --> S4 --> S5
    end
    subgraph apply["<b>Change and verify</b>"]
        direction LR
        S6["<b>6 · Apply</b><br>packages, wrapper,<br>license, each change"]:::step
        S7["<b>7 · Verify</b><br>build, checker,<br>compare with baseline"]:::check
        S8(["<b>8 · Report</b><br>what changed,<br>what is left"]):::good
        S6 --> S7 -->|"nothing lost"| S8
        S7 -->|"lost feature<br>or error"| S6
    end
    Req --> before
    before -->|"developer<br>decides"| plan
    plan --> apply
    classDef ask fill:#17224f,stroke:#17224f,color:#ffffff
    classDef decide fill:#eef1ff,stroke:#335dff,color:#17224f
    classDef step fill:#ffffff,stroke:#335dff,color:#17224f,stroke-width:1.5px
    classDef check fill:#fff4e5,stroke:#e18114,color:#17224f,stroke-width:1.5px
    classDef good fill:#e8f6e9,stroke:#41af46,color:#17224f,stroke-width:1.5px
    classDef docs fill:#eef1ff,stroke:#6686ff,color:#17224f
